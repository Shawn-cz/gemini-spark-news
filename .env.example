# 服务监听端口
PORT=3001

# 生产环境标识 (development / production)
NODE_ENV=production

# 核心管理操作鉴权秘钥 (必须修改为强随机密码，用于 DevTools 调度与模型热切鉴权)
ADMIN_KEY=your_secure_admin_secret_key_here

# 跨域域名白名单 (逗号分隔)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 全局与敏感操作限流上限
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_ADMIN=10

# MongoDB Atlas 云数据库连接串
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/gemini_news?retryWrites=true&w=majority

# Google Gemini 智能体 API 密钥
GEMINI_API_KEY=your_gemini_api_key_here

# 默认激活模型 (gemini-3.8-flash 或 gemini-3.1-pro)
GEMINI_MODEL=gemini-3.8-flash

# 每日定时调度生产时间
SCHEDULE_TIME=08:30
