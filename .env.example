# ==============================================================================
# Gemini Spark Intelligence - 环境变量配置模版
# ==============================================================================
# 适用平台: Local 本地开发 / PaaS 云平台 (Render, Railway, Fly.io, Zeabur)
# 部署说明:
#   - 本地开发: 复制本文件为 .env 并按需填写变量值
#   - PaaS 部署: 在平台控制台 (Environment Variables) 中配置相应键值对
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 服务运行与网络配置 (Server & Network)
# ------------------------------------------------------------------------------
# 服务监听端口
# - Local 本地默认: 3001
# - Render: 平台默认注入 10000 (render.yaml 中已预设)
# - Railway / Zeabur: 平台自动随机分配 $PORT，容器内部服务已自动适配 process.env.PORT
# - Fly.io: 内部端口需与 fly.toml 中的 internal_port (3001) 保持一致
PORT=3001

# 生产环境标识
# 可选值: development | production | test
# 云原生 PaaS 部署时请统一设为 production
NODE_ENV=production

# 跨域资源共享 (CORS) 允许来源白名单
# 多个域名使用英文逗号分隔。如绑定自定义独立域名或前端部署在 Vercel/Netlify，请在此追加
# 支持通配符或指定具体域名，例如: https://news.example.com,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. 安全鉴权与管理秘钥 (Security & Admin Authorization)
# ------------------------------------------------------------------------------
# 核心管理与 Webhook 摄取操作鉴权秘钥 (必须修改为强随机密码，例如通过 openssl rand -hex 24 生成)
# 应用场景:
#   1. Gemini Spark Webhook 摄取:
#      - POST /api/spark/webhook/ingest?key=<ADMIN_KEY>
#      - 或 Header 带上 x-admin-key: <ADMIN_KEY> / Authorization: Bearer <ADMIN_KEY>
#   2. DevTools 开发者面板手动调度: POST /api/spark/trigger
#   3. LLM 模型热切换与调度控制: POST /api/spark/model
ADMIN_KEY=your_secure_admin_secret_key_here

# 全局 API 限流阈值 (每分钟窗口内允许的最大请求数，防范 DDoS 与爬虫)
RATE_LIMIT_GLOBAL=120

# 敏感管理操作限流阈值 (每分钟窗口内允许的最大管理员操作数，防范暴力破解)
RATE_LIMIT_ADMIN=10

# ------------------------------------------------------------------------------
# 3. 数据库持久化配置 (Database Persistence - MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB Atlas 云数据库连接串 (推荐使用 M0 免费沙盒集群)
# 配置要点:
#   1. 前往 https://cloud.mongodb.com 创建免费 M0 Cluster
#   2. 在 Network Access 中配置 IP Access List: 0.0.0.0/0 (允许云端 PaaS 动态 IP 接入)
#   3. 在 Database Access 中创建读写数据库用户，并将账号密码替换下方占位符
# 注: 若留空或连接失败，系统将自动回退为 local-json 本地双写持久化模式
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/gemini_news?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. Google Gemini 智能体与调度生成 (Gemini AI Agent & Scheduler)
# ------------------------------------------------------------------------------
# Google Gemini API 密钥
# 获取地址: Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 默认激活模型名称
# 候选模型: gemini-3.8-flash (兼具极速分析与低调用成本, 推荐) | gemini-3.1-pro (深度推理)
GEMINI_MODEL=gemini-3.8-flash

# 每日定时简报自动生成时间 (24小时制 HH:mm，如 "08:30" 触发每日晨报)
SCHEDULE_TIME=08:30
